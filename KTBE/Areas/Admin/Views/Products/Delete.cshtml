@model KTBE.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này?</h3>
<div>
    <dl class="dl-horizontal mb-3">
        <dt class="fw-bold">Tên sản phẩm:</dt>
        <dd>@Html.DisplayFor(model => model.ProductName)</dd>

        <dt class="fw-bold">Danh mục:</dt>
        <dd>@(Model.Category != null ? Model.Category.CategoryName : "N/A")</dd>

        <dt class="fw-bold">Đơn giá:</dt>
        <dd>@Model.ProductPrice.ToString("N0") đ</dd>
    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
        </div>
    }
</div>
