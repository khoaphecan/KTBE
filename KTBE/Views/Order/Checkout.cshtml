@model KTBE.Models.Customer

@{
    ViewBag.Title = "Xác nhận đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cart = ViewBag.Cart as KTBE.Models.ViewModel.Cart ?? Session["Cart"] as KTBE.Models.ViewModel.Cart;
}

<div class="py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Cart")">Giỏ hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán & Đặt hàng</li>
        </ol>
    </nav>

    <h3 class="fw-bold mb-4 border-bottom pb-2">THÔNG TIN ĐẶT HÀNG</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- Cột trái: Thông tin nhận hàng, Giao hàng & Thanh toán -->
            <div class="col-md-7">
                <!-- 1. Thông tin người nhận -->
                <div class="card mb-3 bg-white" style="border: 1px solid #ddd;">
                    <div class="card-header bg-light fw-bold py-2">
                        1. Thông tin người nhận & Địa chỉ giao hàng
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và tên người nhận (*)</label>
                            <input type="text" name="customerName" class="form-control" value="@(Model != null ? Model.CustomerName : "")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại liên hệ (*)</label>
                            <input type="tel" name="customerPhone" class="form-control" value="@(Model != null ? Model.CustomerPhone : "")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ giao hàng chi tiết (*)</label>
                            <textarea name="shippingAddress" rows="3" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." required>@(Model != null ? Model.CustomerAddress : "")</textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. Phương thức vận chuyển -->
                <div class="card mb-3 bg-white" style="border: 1px solid #ddd;">
                    <div class="card-header bg-light fw-bold py-2">
                        2. Phương thức giao hàng
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="shippingMethod" id="ship1" value="Giao hàng tiêu chuẩn" checked />
                            <label class="form-check-label" for="ship1">
                                <strong>Giao hàng tiêu chuẩn</strong> (2 - 4 ngày làm việc) - <span class="text-success fw-bold">Miễn phí vận chuyển</span>
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="shippingMethod" id="ship2" value="Giao hàng nhanh" />
                            <label class="form-check-label" for="ship2">
                                <strong>Giao hàng nhanh</strong> (1 - 2 ngày làm việc)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="shippingMethod" id="ship3" value="Giao hàng hỏa tốc trong ngày" />
                            <label class="form-check-label" for="ship3">
                                <strong>Giao hàng hỏa tốc trong ngày</strong> (Nội thành)
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 3. Phương thức thanh toán -->
                <div class="card mb-3 bg-white" style="border: 1px solid #ddd;">
                    <div class="card-header bg-light fw-bold py-2">
                        3. Phương thức thanh toán
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pay1" value="Thanh toán khi nhận hàng (COD)" checked />
                            <label class="form-check-label" for="pay1">
                                <strong>Thanh toán tiền mặt khi nhận hàng (COD)</strong>
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pay2" value="Chuyển khoản ngân hàng" />
                            <label class="form-check-label" for="pay2">
                                <strong>Chuyển khoản ngân hàng qua mã QR</strong>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pay3" value="Ví điện tử MoMo" />
                            <label class="form-check-label" for="pay3">
                                <strong>Ví điện tử MoMo / ZaloPay</strong>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt đơn hàng -->
            <div class="col-md-5">
                <div class="card p-3 bg-white sticky-top" style="border: 1px solid #ddd; top: 20px;">
                    <h5 class="fw-bold border-bottom pb-2">ĐƠN HÀNG CỦA BẠN</h5>

                    @if (cart != null && cart.Items.Any())
                    {
                        <div class="table-responsive mb-3" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    @foreach (var item in cart.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark small">@item.ProductName</div>
                                                <div class="text-muted small">@item.Quantity x @item.UnitPrice.ToString("N0") đ</div>
                                            </td>
                                            <td class="text-end fw-bold text-nowrap">
                                                @item.TotalPrice.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <hr class="my-2" />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Số lượng sản phẩm:</span>
                            <strong>@cart.TotalQuantity</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success fw-bold">0 đ (Freeship)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-top pt-2">
                            <span class="fs-6 fw-bold">Tổng thanh toán:</span>
                            <span class="text-danger fs-5 fw-bold">@cart.TotalAmount.ToString("N0") đ</span>
                        </div>

                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold py-2">
                            XÁC NHẬN ĐẶT HÀNG
                        </button>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Giỏ hàng trống.</p>
                    }

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Index", "Cart")" class="text-decoration-none text-secondary small">
                            &laquo; Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
