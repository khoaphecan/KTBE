@model KTBE.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hóa đơn đơn hàng #@Model.OrderID</li>
        </ol>
    </nav>

    <div class="card bg-white p-4 mb-4" style="border: 1px solid #ddd;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <div>
                <h3 class="fw-bold mb-1">HÓA ĐƠN ĐƠN HÀNG #@Model.OrderID</h3>
                <div class="text-muted small">
                    Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")
                </div>
            </div>
            <div class="text-end">
                <div>
                    Trạng thái đơn: <span class="badge bg-primary">@Model.OrderStatus</span>
                </div>
                <div class="mt-1">
                    Thanh toán: <span class="badge bg-secondary">@Model.PaymentStatus</span>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h5 class="fw-bold border-bottom pb-2 mb-2">Thông tin người nhận</h5>
                <p class="mb-1"><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "N/A")</p>
                <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "N/A")</p>
                <p class="mb-0"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold border-bottom pb-2 mb-2">Thông tin thanh toán & vận chuyển</h5>
                <p class="mb-1"><strong>Phương thức giao hàng:</strong> @(string.IsNullOrEmpty(Model.ShippingMethod) ? "Giao hàng tiêu chuẩn" : Model.ShippingMethod)</p>
                <p class="mb-1"><strong>Phương thức thanh toán:</strong> @(string.IsNullOrEmpty(Model.PaymentMethod) ? "Tiền mặt (COD)" : Model.PaymentMethod)</p>
                <p class="mb-0"><strong>Phí vận chuyển:</strong> <span class="text-success fw-bold">0 đ (Freeship)</span></p>
            </div>
        </div>

        <!-- Nhúng Partial View dùng chung với Admin -->
        <h5 class="fw-bold border-bottom pb-2 mb-3">Chi tiết các sản phẩm trong đơn</h5>
        @Html.Partial("~/Views/Shared/_PVOrderDetails.cshtml", Model.OrderDetails)

        <div class="d-flex justify-content-end align-items-center mt-3 pt-3 border-top">
            <div class="text-end">
                <span class="fs-6 me-2">Tổng tiền thanh toán:</span>
                <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("BuyAgain", "Order", new { id = Model.OrderID })" class="btn btn-danger px-4">
            Mua lại đơn hàng này
        </a>
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary px-4">
            Quay lại Đơn hàng của tôi
        </a>
        <button type="button" class="btn btn-outline-dark" onclick="window.print()">
            In hóa đơn
        </button>
    </div>
</div>
