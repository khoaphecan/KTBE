@model IEnumerable<KTBE.Models.Product>

@{
    ViewBag.Title = "Trang chủ";
}

<div class="row mb-4">
    <div class="col-md-6 offset-md-3">
        <form class="d-flex" method="get" action="@Url.Action("Index", "Home")">
            <input type="text" name="search" class="form-control me-2" placeholder="Tìm kiếm sản phẩm..." />
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </form>
    </div>
</div>

<h3 class="border-bottom pb-2 mb-4">DANH SÁCH SẢN PHẨM</h3>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            var imgSrc = !string.IsNullOrEmpty(item.ProductImage)
                ? Url.Content(item.ProductImage)
                : Url.Content("~/Content/images/tro-choi.png");

            <div class="col">
                <div class="card h-100 bg-white" style="border: 1px solid #ddd;">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-center p-3">
                        <img src="@imgSrc" alt="@item.ProductName" style="height: 180px; width: auto; max-width: 100%; object-fit: contain;" />
                    </a>
                    <div class="card-body d-flex flex-column pt-0">
                        <div class="text-muted small mb-1">@(item.Category != null ? item.Category.CategoryName : "")</div>
                        <h6 class="card-title fw-bold" style="min-height: 40px; font-size: 14px; line-height: 1.3;">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-decoration-none text-dark">
                                @item.ProductName
                            </a>
                        </h6>
                        <div class="text-danger fw-bold fs-6 mb-3">
                            @item.ProductPrice.ToString("N0") đ
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-primary btn-sm w-50">
                                Mua hàng
                            </a>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-info btn-sm w-50 text-white">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
