@model KTBE.Models.Product

@{
    ViewBag.Title = Model.ProductName;
    var imgSrc = !string.IsNullOrEmpty(Model.ProductImage)
        ? Url.Content(Model.ProductImage)
        : Url.Content("~/Content/images/tro-choi.png");
}

<div class="card bg-white p-4 my-4" style="border: 1px solid #ddd;">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@imgSrc" alt="@Model.ProductName" style="max-height: 350px; width: auto; max-width: 100%; object-fit: contain; border: 1px solid #eee; padding: 10px;" />
        </div>
        <div class="col-md-7">
            <h3 class="fw-bold">@Model.ProductName</h3>
            <p class="text-muted">Danh mục: <strong>@(Model.Category != null ? Model.Category.CategoryName : "N/A")</strong></p>
            <h4 class="text-danger fw-bold my-3">@Model.ProductPrice.ToString("N0") đ</h4>
            
            <div class="my-4">
                <h5>Mô tả sản phẩm</h5>
                <p class="text-secondary">@Model.ProductDecription</p>
            </div>

            <div class="d-flex gap-2">
                <a href="@Url.Action("AddToCart", "Cart", new { id = Model.ProductID, quantity = 1 })" class="btn btn-primary px-4">
                    Thêm vào giỏ hàng
                </a>
                <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary px-4">
                    Đơn hàng của tôi
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-default border px-4">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
