@model KTBE.Models.ViewModel.Cart

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-3">
    <h3 class="fw-bold mb-4 border-bottom pb-2">GIỎ HÀNG CỦA BẠN</h3>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="card p-5 text-center bg-white" style="border: 1px solid #ddd;">
            <h5 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h5>
            <div>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">Tiếp tục mua hàng</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <table class="table table-bordered bg-white align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center" style="width: 120px;">Đơn giá</th>
                            <th class="text-center" style="width: 100px;">Số lượng</th>
                            <th class="text-end" style="width: 130px;">Thành tiền</th>
                            <th class="text-center" style="width: 60px;">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var imgSrc = !string.IsNullOrEmpty(item.ProductImage)
                                ? Url.Content(item.ProductImage)
                                : Url.Content("~/Content/images/tro-choi.png");

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@imgSrc" alt="@item.ProductName" style="width: 50px; height: 65px; object-fit: cover; margin-right: 12px; border: 1px solid #eee;" />
                                        <div>
                                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-decoration-none text-dark fw-bold">
                                                @item.ProductName
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-center">
                                    @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        <input type="hidden" name="id" value="@item.ProductID" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control form-control-sm text-center" style="width: 65px; margin: 0 auto;" onchange="this.form.submit()" />
                                    }
                                </td>
                                <td class="text-end fw-bold text-danger">@item.TotalPrice.ToString("N0") đ</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Remove", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        &times;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        Tiếp tục mua hàng
                    </a>
                    <a href="@Url.Action("Clear", "Cart")" class="btn btn-outline-danger ms-2">
                        Xóa tất cả
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3 bg-white" style="border: 1px solid #ddd;">
                    <h5 class="fw-bold border-bottom pb-2">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Số lượng sản phẩm:</span>
                        <strong>@Model.TotalQuantity</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Tổng tiền:</span>
                        <strong class="text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                    <a href="@Url.Action("Checkout", "Order")" class="btn btn-danger w-100 py-2 fw-bold mb-2">
                        Tiến hành đặt hàng
                    </a>
                    <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary w-100 py-2">
                        Xem lịch sử mua hàng
                    </a>
                </div>
            </div>
        </div>
    }
</div>
